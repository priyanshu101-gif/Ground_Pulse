# GroundPulse — Campus Sports Ground Discovery & Availability
# Supabase Configuration
# Create a project at https://supabase.com and copy credentials from Project Settings > API
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# Report Freshness Thresholds (in minutes)
# Reports younger than FRESH are marked "Fresh" (High confidence)
# Reports between FRESH and AGING are marked "Aging" (Moderate confidence)
# Reports older than AGING are marked "Stale / Expired"
VITE_FRESHNESS_FRESH_MINUTES=15
VITE_FRESHNESS_AGING_MINUTES=60

# Campus Default Coordinates (Latitude, Longitude, Zoom Level)
VITE_CAMPUS_DEFAULT_LAT=37.4275
VITE_CAMPUS_DEFAULT_LNG=-122.1697
VITE_CAMPUS_DEFAULT_ZOOM=15

# GEMINI_API_KEY: Optional backend AI key if configured
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Cloud Run / deployment host URL
APP_URL="MY_APP_URL"

